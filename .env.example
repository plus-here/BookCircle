# Copy to .env on Mac/Linux if you want to customize startup scripts.

# sqlite is easiest for local Mac demo. Use mysql to match the Windows dev database setup.
BOOKCIRCLE_DB=sqlite

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-for-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,*

# Only used when BOOKCIRCLE_DB=mysql. Do not commit your real local password.
MYSQL_DATABASE=bookcircle
MYSQL_USER=bookcircle_user
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Optional WebRTC TURN/STUN override for real public-network video calls.
# Example:
# VITE_RTC_ICE_SERVERS=[{"urls":"turn:your-domain:3478","username":"user","credential":"pass"}]
# VITE_RTC_ICE_TRANSPORT_POLICY=all
